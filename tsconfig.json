        "strict": true,
        "target": "ES2018",
        "lib": [
            "ES2018",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.vue"
    ]
}
